generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  role         Role
  password     String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  actions      AuditLog[]
  payments     Payment[]
  stockLedger  StockLedger[]
  transactions Transaction[]
  outlets      Outlet[]      @relation("OutletToUser")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Warehouse {
  id                String        @id @default(cuid())
  name              String
  address           String?
  state             String?
  contactName       String?
  contactPhone      String?
  isDefault         Boolean       @default(false)
  outletId          String
  outlet            Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  batches           CustomBatch[]
  stocks            Stock[]
  stockLedger       StockLedger[]
  outboundTransfers Transaction[] @relation("FromWarehouse")
  inboundTransfers  Transaction[] @relation("ToWarehouse")
}

model Outlet {
  id                       String           @id @default(cuid())
  name                     String
  address                  String?
  state                    String?
  invoicePrefix            String
  invoiceStartingNumber    Int              @default(1)
  gstin                    String?
  bankDetails              String?
  negativeStockPolicy      String           @default("WARN")
  batchTrackingEnabled     Boolean          @default(false)
  allowRawCashBills        Boolean          @default(false)
  inventoryValuationMethod String           @default("NONE")
  accounts                 Account[]
  categories               Category[]
  batches                  CustomBatch[]
  series                   DocumentSeries[]
  parties                  Party[]
  payments                 Payment[]
  products                 Product[]
  stocks                   Stock[]
  stockLedger              StockLedger[]
  transactions             Transaction[]
  users                    User[]           @relation("OutletToUser")
  warehouses               Warehouse[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  parentId    String?
  description String?
  isActive    Boolean    @default(true)
  outletId    String
  outlet      Outlet     @relation(fields: [outletId], references: [id])
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@unique([name, parentId, outletId])
}

model Product {
  id              String    @id @default(cuid())
  name            String
  brand           String?
  hsnCode         String?
  gstRate         Float
  baseUnit        String
  purchaseUnit    String?
  conversionRatio Float?    @default(1)
  categoryId      String
  isArchived      Boolean   @default(false)
  outletId        String
  category        Category  @relation(fields: [categoryId], references: [id])
  outlet          Outlet    @relation(fields: [outletId], references: [id])
  variants        Variant[]

  @@unique([name, outletId])
  @@index([outletId, isArchived])
  @@index([outletId, categoryId, isArchived])
}

model Variant {
  id               String            @id @default(cuid())
  productId        String
  sku              String            @unique
  specifications   Json?
  purchasePrice    Float
  sellingPrice     Float
  pricingMethod    String            @default("MANUAL")
  markupPercent    Float?
  minStockLevel    Float             @default(0)
  batches          CustomBatch[]
  priceListEntries PriceListEntry[]
  stocks           Stock[]
  stockLedger      StockLedger[]
  txnItems         TransactionItem[]
  product          Product           @relation(fields: [productId], references: [id])
  suppliers        VendorProduct[]
}

model Stock {
  id           String     @id @default(cuid())
  variantId    String
  warehouseId  String?
  outletId     String?
  quantity     Float      @default(0)
  inTransitQty Float      @default(0)
  outlet       Outlet?    @relation(fields: [outletId], references: [id])
  variant      Variant    @relation(fields: [variantId], references: [id])
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, warehouseId, outletId])
}

model Party {
  id                   String          @id @default(cuid())
  type                 PartyType
  name                 String
  gstin                String?
  pan                  String?
  address              String
  state                String
  contactInfo          String?
  creditPeriod         Int             @default(0)
  creditLimit          Float?
  openingBalance       Float           @default(0)
  priceListId          String?
  outletId             String
  outstandingBalance   Float           @default(0)
  bankAccountName      String?
  bankAccountNumber    String?
  bankIfsc             String?
  bankName             String?
  email                String?
  isActive             Boolean         @default(true)
  openingBalanceLocked Boolean         @default(false)
  phone                String?
  creditBalance        Float           @default(0)
  ledgerEntries        LedgerEntry[]
  outlet               Outlet          @relation(fields: [outletId], references: [id])
  priceList            PriceList?      @relation(fields: [priceListId], references: [id])
  payments             Payment[]
  transactions         Transaction[]
  suppliedProducts     VendorProduct[]

  @@index([outletId, type, isActive])
  @@index([outletId, type, name])
  @@index([outletId, type, outstandingBalance])
}

model Transaction {
  id             String            @id @default(cuid())
  type           TxType
  txnNumber      String            @unique
  date           DateTime          @default(now())
  partyId        String?
  outletId       String
  fromLocationId String?
  toLocationId   String?
  totalTaxable   Float             @default(0)
  totalTax       Float             @default(0)
  freightCost    Float?            @default(0)
  globalDiscount Float?            @default(0)
  grandTotal     Float             @default(0)
  status         String            @default("DRAFT")
  isInformal     Boolean           @default(false)
  buyerName      String?
  buyerPhone     String?
  parentId       String?
  userId         String
  remarks        String?
  billType       BillType          @default(NO1)
  paidAt         DateTime?
  batchMovements BatchMovement[]
  ledgerEntries  LedgerEntry[]
  payments       Payment[]
  stockLedger    StockLedger[]
  fromWarehouse  Warehouse?        @relation("FromWarehouse", fields: [fromLocationId], references: [id])
  outlet         Outlet            @relation(fields: [outletId], references: [id])
  parent         Transaction?      @relation("TxFlow", fields: [parentId], references: [id])
  children       Transaction[]     @relation("TxFlow")
  party          Party?            @relation(fields: [partyId], references: [id])
  toWarehouse    Warehouse?        @relation("ToWarehouse", fields: [toLocationId], references: [id])
  user           User              @relation(fields: [userId], references: [id])
  items          TransactionItem[]

  @@index([outletId, type, status])
  @@index([outletId, type, date])
  @@index([outletId, type, partyId])
}

model TransactionItem {
  id              String      @id @default(cuid())
  transactionId   String
  variantId       String
  quantity        Float
  unit            String?
  conversionRatio Float?      @default(1)
  rate            Float
  discountPercent Float?      @default(0)
  discountAmount  Float?      @default(0)
  freightFraction Float?
  taxableValue    Float
  cgst            Float       @default(0)
  sgst            Float       @default(0)
  igst            Float       @default(0)
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  variant         Variant     @relation(fields: [variantId], references: [id])
}

model Account {
  id       String        @id @default(cuid())
  code     String
  name     String
  group    AccountGroup
  isSystem Boolean       @default(false)
  outletId String
  outlet   Outlet        @relation(fields: [outletId], references: [id])
  entries  LedgerEntry[]
  payments Payment[]

  @@unique([code, outletId])
}

model LedgerEntry {
  id            String       @id @default(cuid())
  accountId     String
  partyId       String?
  transactionId String?
  date          DateTime     @default(now())
  debit         Float        @default(0)
  credit        Float        @default(0)
  reference     String?
  isReconciled  Boolean      @default(false)
  account       Account      @relation(fields: [accountId], references: [id])
  party         Party?       @relation(fields: [partyId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
}

model VendorProduct {
  id        String  @id @default(cuid())
  vendorId  String
  variantId String
  lastPrice Float?
  leadTime  Int?
  variant   Variant @relation(fields: [variantId], references: [id])
  vendor    Party   @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, variantId])
}

model PriceList {
  id          String           @id @default(cuid())
  name        String
  description String?
  isActive    Boolean          @default(true)
  parties     Party[]
  entries     PriceListEntry[]
}

model DocumentSeries {
  id            String   @id @default(cuid())
  type          String
  prefix        String
  nextNumber    Int      @default(1)
  financialYear String
  outletId      String
  updatedAt     DateTime @updatedAt
  outlet        Outlet   @relation(fields: [outletId], references: [id])

  @@unique([type, financialYear, outletId])
}

model CustomBatch {
  id               String          @id @default(cuid())
  batchNumber      String          @unique
  variantId        String
  warehouseId      String
  outletId         String
  receivedDate     DateTime        @default(now())
  quantityReceived Float
  quantityConsumed Float           @default(0)
  costPerUnit      Float
  createdAt        DateTime        @default(now())
  movements        BatchMovement[]
  outlet           Outlet          @relation(fields: [outletId], references: [id])
  variant          Variant         @relation(fields: [variantId], references: [id])
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id])

  @@index([variantId, warehouseId, receivedDate])
}

model BatchMovement {
  id            String      @id @default(cuid())
  batchId       String
  transactionId String
  quantity      Float
  date          DateTime    @default(now())
  batch         CustomBatch @relation(fields: [batchId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model StockLedger {
  id            String      @id @default(cuid())
  variantId     String
  warehouseId   String
  outletId      String
  transactionId String
  date          DateTime    @default(now())
  quantity      Float
  balance       Float
  type          String
  userId        String
  costPerUnit   Float?
  outlet        Outlet      @relation(fields: [outletId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  variant       Variant     @relation(fields: [variantId], references: [id])
  warehouse     Warehouse   @relation(fields: [warehouseId], references: [id])

  @@index([variantId, warehouseId, date])
}

model Payment {
  id            String      @id @default(cuid())
  txnNumber     String      @unique
  invoiceId     String
  outletId      String
  partyId       String
  amount        Float
  paymentDate   DateTime
  paymentMode   String
  bankAccountId String?
  referenceNo   String?
  notes         String?
  createdBy     String
  createdAt     DateTime    @default(now())
  bankAccount   Account?    @relation(fields: [bankAccountId], references: [id])
  creator       User        @relation(fields: [createdBy], references: [id])
  invoice       Transaction @relation(fields: [invoiceId], references: [id])
  outlet        Outlet      @relation(fields: [outletId], references: [id])
  party         Party       @relation(fields: [partyId], references: [id])

  @@index([invoiceId])
  @@index([partyId, outletId])
}

model PriceListEntry {
  id          String    @id @default(cuid())
  priceListId String
  variantId   String
  price       Float
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant     Variant   @relation(fields: [variantId], references: [id])

  @@unique([priceListId, variantId])
}

enum Role {
  ADMIN
  ACCOUNTANT
  SALES
  INVENTORY_MANAGER
}

enum PartyType {
  VENDOR
  CUSTOMER
}

enum TxType {
  PURCHASE_ORDER
  GRN
  PURCHASE_BILL
  DEBIT_NOTE
  PROFORMA_INVOICE
  DELIVERY_CHALLAN
  SALES_INVOICE
  CREDIT_NOTE
  STOCK_TRANSFER
  STOCK_ADJUSTMENT
  QUOTATION
  PURCHASE_REQUEST
  STOCK_RETURN
}

enum AccountGroup {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum BillType {
  NO1
  NO2
}

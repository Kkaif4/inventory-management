generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  role         Role
  password     String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  actions      AuditLog[]
  payments     Payment[]
  stockLedger  StockLedger[]
  transactions Transaction[]
  expenses     Expense[]
  outlets      Outlet[]      @relation("OutletToUser")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
}

model Warehouse {
  id                String        @id @default(cuid())
  name              String
  address           String?
  state             String?
  contactName       String?
  contactPhone      String?
  isDefault         Boolean       @default(false)
  outletId          String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  outlet            Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  batches           CustomBatch[]
  stocks            Stock[]
  stockLedger       StockLedger[]
  outboundTransfers Transaction[] @relation("FromWarehouse")
  inboundTransfers  Transaction[] @relation("ToWarehouse")

  @@index([outletId])
}

model Outlet {
  id                       String            @id @default(cuid())
  name                     String
  address                  String?
  state                    String?
  invoicePrefix            String
  invoiceStartingNumber    Int               @default(1)
  gstin                    String?
  bankDetails              String?
  negativeStockPolicy      NegativeStockPolicy @default(WARN)
  batchTrackingEnabled     Boolean             @default(false)
  allowRawCashBills        Boolean             @default(false)
  inventoryValuationMethod ValuationMethod     @default(NONE)
  batchPricingMode         BatchPricingMode    @default(STRICT)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  accounts                 Account[]
  categories               Category[]
  batches                  CustomBatch[]
  series                   DocumentSeries[]
  parties                  Party[]
  payments                 Payment[]
  products                 Product[]
  stocks                   Stock[]
  stockLedger              StockLedger[]
  transactions             Transaction[]
  expenses                 Expense[]
  users                    User[]            @relation("OutletToUser")
  warehouses               Warehouse[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  parentId    String?
  description String?
  isActive    Boolean    @default(true)
  outletId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  outlet      Outlet     @relation(fields: [outletId], references: [id])
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@unique([name, parentId, outletId])
}

model Product {
  id              String    @id @default(cuid())
  name            String
  brand           String?
  hsnCode         String?
  gstRate         Float
  baseUnit        String
  purchaseUnit    String?
  conversionRatio Float?    @default(1)
  categoryId      String
  isArchived      Boolean   @default(false)
  outletId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  category        Category  @relation(fields: [categoryId], references: [id])
  outlet          Outlet    @relation(fields: [outletId], references: [id])
  variants        Variant[]

  @@index([outletId, isArchived])
  @@index([outletId, categoryId, isArchived])
  @@index([categoryId])
}

model Variant {
  id               String            @id @default(cuid())
  productId        String
  sku              String
  outletId         String
  specifications   Json?
  purchasePrice    Float
  sellingPrice     Float
  pricingMethod    PricingMethod     @default(MANUAL)
  markupPercent    Float?
  minStockLevel    Float             @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  batches          CustomBatch[]
  priceListEntries PriceListEntry[]
  stocks           Stock[]
  stockLedger      StockLedger[]
  txnItems         TransactionItem[]
  product          Product           @relation(fields: [productId], references: [id])
  suppliers        VendorProduct[]

  @@unique([sku, outletId])
  @@index([productId])
}

model Stock {
  id           String     @id @default(cuid())
  variantId    String
  warehouseId  String?
  outletId     String?
  quantity     Float      @default(0)
  inTransitQty Float      @default(0)
  updatedAt    DateTime   @updatedAt
  outlet       Outlet?    @relation(fields: [outletId], references: [id])
  variant      Variant    @relation(fields: [variantId], references: [id])
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, warehouseId, outletId])
  @@index([outletId, quantity])
}

model Party {
  id                   String          @id @default(cuid())
  type                 PartyType
  name                 String
  gstin                String?
  pan                  String?
  address              String
  state                String
  contactInfo          String?
  creditPeriod         Int             @default(0)
  creditLimit          Float?
  openingBalance       Float           @default(0)
  priceListId          String?
  outletId             String
  outstandingBalance   Float           @default(0)
  bankAccountName      String?
  bankAccountNumber    String?
  bankIfsc             String?
  bankName             String?
  email                String?
  isActive             Boolean         @default(true)
  openingBalanceLocked Boolean         @default(false)
  phone                String?
  creditBalance        Float           @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  ledgerEntries        LedgerEntry[]
  outlet               Outlet          @relation(fields: [outletId], references: [id])
  priceList            PriceList?      @relation(fields: [priceListId], references: [id])
  payments             Payment[]
  transactions         Transaction[]
  expenses             Expense[]
  suppliedProducts     VendorProduct[]

  @@index([outletId, type, isActive])
  @@index([outletId, type, name])
  @@index([outletId, type, outstandingBalance])
}

model Transaction {
  id              String            @id @default(cuid())
  type            TxType
  txnNumber       String            @unique
  date            DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  partyId         String?
  outletId        String
  fromLocationId  String?
  toLocationId    String?
  totalTaxable    Float             @default(0)
  totalTax        Float             @default(0)
  freightCost     Float?            @default(0)
  globalDiscount  Float?            @default(0)
  grandTotal      Float             @default(0)
  status          TxStatus          @default(DRAFT)
  isInformal      Boolean           @default(false)
  buyerName       String?
  buyerPhone      String?
  parentId        String?
  userId          String
  remarks         String?
  billType        BillType          @default(NO1)
  customBillNo    String? // Optional user-supplied bill number from physical book
  paidAt          DateTime?
  batchMovements  BatchMovement[]
  ledgerEntries   LedgerEntry[]
  payments        Payment[]
  stockLedger     StockLedger[]
  fromWarehouse   Warehouse?        @relation("FromWarehouse", fields: [fromLocationId], references: [id])
  outlet          Outlet            @relation(fields: [outletId], references: [id])
  parent          Transaction?      @relation("TxFlow", fields: [parentId], references: [id])
  children        Transaction[]     @relation("TxFlow")
  party           Party?            @relation(fields: [partyId], references: [id])
  toWarehouse     Warehouse?        @relation("ToWarehouse", fields: [toLocationId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  items           TransactionItem[]
  oldBillPayments OldBillPayment[]

  @@index([outletId, type, status])
  @@index([outletId, type, date])
  @@index([outletId, type, partyId])
  @@index([parentId])
}

model TransactionItem {
  id              String      @id @default(cuid())
  transactionId   String
  variantId       String? // null for OLD bill freeform items
  itemDescription String? // freeform description for OLD bill items
  quantity        Float
  unit            String?
  conversionRatio Float?      @default(1)
  rate            Float
  discountPercent Float?      @default(0)
  discountAmount  Float?      @default(0)
  freightFraction Float?
  taxableValue    Float
  cgst            Float       @default(0)
  sgst            Float       @default(0)
  igst            Float       @default(0)
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  variant         Variant?    @relation(fields: [variantId], references: [id])

  @@index([transactionId])
  @@index([variantId])
}

model LedgerEntry {
  id            String       @id @default(cuid())
  accountId     String
  partyId       String?
  transactionId String?
  date          DateTime     @default(now())
  createdAt     DateTime     @default(now())
  debit         Float        @default(0)
  credit        Float        @default(0)
  reference     String?
  isReconciled  Boolean      @default(false)
  account       Account      @relation(fields: [accountId], references: [id])
  party         Party?       @relation(fields: [partyId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([accountId])
  @@index([date])
  @@index([accountId, date])
  @@index([partyId, date])
  @@index([transactionId])
}

model VendorProduct {
  id        String   @id @default(cuid())
  vendorId  String
  variantId String
  lastPrice Float?
  leadTime  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  variant   Variant  @relation(fields: [variantId], references: [id])
  vendor    Party    @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, variantId])
}

model PriceList {
  id          String           @id @default(cuid())
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  parties     Party[]
  entries     PriceListEntry[]
}

model DocumentSeries {
  id            String   @id @default(cuid())
  type          String
  prefix        String
  nextNumber    Int      @default(1)
  financialYear String
  outletId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  outlet        Outlet   @relation(fields: [outletId], references: [id])

  @@unique([type, financialYear, outletId])
}

model CustomBatch {
  id                      String          @id @default(cuid())
  batchNumber             String          @unique
  variantId               String
  warehouseId             String
  outletId                String
  grnId                   String?                  // FK to Transaction (GRN)
  purchaseOrderId         String?                  // FK to Transaction (PURCHASE_ORDER)
  purchaseBillId          String?                  // FK to Transaction (PURCHASE_BILL)
  receivedDate            DateTime        @default(now())
  quantityReceived        Float
  quantityConsumed        Float           @default(0)

  // Purchase cost tracking (for COGS/FIFO valuation)
  purchaseUnitRate        Float           @default(0)       // ₹100/Box — original bill rate
  costPerBaseUnit         Float           @default(0)       // ₹10/Piece = purchaseUnitRate / conversionRatio

  status                  String          @default("ACTIVE")  // "ACTIVE" / "EXHAUSTED"
  createdAt               DateTime        @default(now())

  movements               BatchMovement[]
  outlet                  Outlet          @relation(fields: [outletId], references: [id])
  variant                 Variant         @relation(fields: [variantId], references: [id])
  warehouse               Warehouse       @relation(fields: [warehouseId], references: [id])

  @@index([variantId, warehouseId, receivedDate])
  @@index([outletId, variantId, warehouseId, receivedDate])
}

model BatchMovement {
  id            String      @id @default(cuid())
  batchId       String
  transactionId String
  quantity      Float
  date          DateTime    @default(now())
  batch         CustomBatch @relation(fields: [batchId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@index([batchId])
  @@index([transactionId])
}

model StockLedger {
  id            String      @id @default(cuid())
  variantId     String
  warehouseId   String
  outletId      String
  transactionId String
  date          DateTime    @default(now())
  quantity      Float
  balance       Float
  type          StockLedgerType
  userId        String
  costPerUnit   Float?
  outlet        Outlet      @relation(fields: [outletId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  variant       Variant     @relation(fields: [variantId], references: [id])
  warehouse     Warehouse   @relation(fields: [warehouseId], references: [id])

  @@index([variantId, warehouseId, date])
  @@index([transactionId])
  @@index([outletId, variantId])
}

model Payment {
  id              String      @id @default(cuid())
  txnNumber       String      @unique
  invoiceId       String
  outletId        String
  partyId         String
  amount          Float
  paymentDate     DateTime
  paymentMode     PaymentMode
  accountId       String?
  referenceNo     String?
  notes           String?
  createdBy       String
  createdAt       DateTime    @default(now())
  account         Account?    @relation(fields: [accountId], references: [id])
  creator         User        @relation(fields: [createdBy], references: [id])
  invoice         Transaction @relation(fields: [invoiceId], references: [id])
  outlet          Outlet      @relation(fields: [outletId], references: [id])
  party           Party       @relation(fields: [partyId], references: [id])

  @@index([invoiceId])
  @@index([partyId, outletId])
}

model PriceListEntry {
  id          String    @id @default(cuid())
  priceListId String
  variantId   String
  price       Float
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant     Variant   @relation(fields: [variantId], references: [id])

  @@unique([priceListId, variantId])
}

// ============================================
// Operational Accounts & Payment Modes Models
// ============================================

model Account {
  id             String       @id @default(cuid())
  code           String?
  name           String
  group          AccountGroup
  type           AccountType?
  isSystem       Boolean      @default(false)
  openingBalance Float        @default(0)
  currentBalance Float        @default(0)
  outletId       String
  outlet         Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)

  entries       LedgerEntry[]
  paymentModes  AccountPaymentMode[]
  transactions  AccountTransaction[]
  transfersFrom Transfer[]           @relation("fromAccount")
  transfersTo   Transfer[]           @relation("toAccount")
  payments      Payment[]
  expenses      Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, outletId])
  @@unique([name, outletId])
  @@index([outletId])
  @@index([type])
  @@index([outletId, group])
}

model AccountPaymentMode {
  id        String      @id @default(cuid())
  accountId String
  mode      PaymentMode

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, mode])
  @@index([accountId])
}

model AccountTransaction {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type        TransactionType // IN | OUT | TRANSFER_IN | TRANSFER_OUT
  amount      Float
  paymentMode PaymentMode

  // Payment mode specific fields (optional)
  chequeNumber   String?
  chequeDate     DateTime?
  upiReferenceId String?
  transactionId  String? // Online transfer ID

  // Linked transaction
  linkedTxnId   String? // FK to Transaction/Payment/Expense
  linkedTxnType String? // "INVOICE_PAYMENT" | "VENDOR_PAYMENT" | "EXPENSE" | "TRANSFER"

  // Balance snapshot
  balanceAfter Float

  remarks   String?
  userId    String
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([type])
  @@index([createdAt])
  @@index([linkedTxnId])
}

model Transfer {
  id            String @id @default(cuid())
  fromAccountId String
  toAccountId   String

  fromAccount Account @relation("fromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account @relation("toAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  amount  Float
  date    DateTime
  remarks String?

  userId    String
  createdAt DateTime @default(now())

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([createdAt])
}

model ExpenseCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  code        String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([code])
}

model Expense {
  id       String @id @default(cuid())
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  txnNumber   String // EXP-0001, EXP-0002
  date        DateTime
  description String

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  vendorId String?
  vendor   Party?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  taxableAmount Decimal @db.Decimal(12, 2)
  gstRate       Int? // 0, 5, 12, 18
  inputGst      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal @db.Decimal(12, 2)

  paymentMode PaymentMode
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])

  status ExpenseStatus @default(POSTED)

  createdBy String
  user      User   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outletId])
  @@index([categoryId])
  @@index([accountId])
  @@index([date])
  @@index([status])
}

model Attachment {
  id String @id @default(cuid())

  moduleType  String // "EXPENSE" | "INVOICE"
  referenceId String

  fileName String
  mimeType String @default("image/webp")
  size     Int
  data     Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleType, referenceId])
  @@index([moduleType])
  @@index([createdAt])
}

enum Role {
  ADMIN
  ACCOUNTANT
  SALES
  INVENTORY_MANAGER
}

enum TxStatus {
  DRAFT
  PENDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PARTIAL
  PARTIALLY_PAID
  CONFIRMED
  POSTED
  PAID
  SHIPPED
  RECEIVED
  ACCEPTED
  CONVERTED
  CANCELLED
  COMPLETED
}

enum StockLedgerType {
  PURCHASE
  SALE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_INC
  ADJUSTMENT_DEC
}

enum NegativeStockPolicy {
  WARN
  ALLOW
  BLOCK
}

enum ValuationMethod {
  NONE
  FIFO
}

enum PricingMethod {
  MANUAL
  MARKUP
}

enum BatchPricingMode {
  STRICT
  LATEST_BATCH
}

enum ExpenseStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PartyType {
  VENDOR
  CUSTOMER
}

enum TxType {
  PURCHASE_ORDER
  GRN
  PURCHASE_BILL
  DEBIT_NOTE
  PROFORMA_INVOICE
  DELIVERY_CHALLAN
  SALES_INVOICE
  CREDIT_NOTE
  STOCK_TRANSFER
  STOCK_ADJUSTMENT
  QUOTATION
  PURCHASE_REQUEST
  STOCK_RETURN
}

enum AccountGroup {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum BillType {
  NO1
  NO2
  OLD
}

enum AccountType {
  CASH
  BANK
}

enum PaymentMode {
  CASH
  UPI
  CHEQUE
  ONLINE_TRANSFER
  CARD
}

enum TransactionType {
  IN
  OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model OldBillPayment {
  id            String      @id @default(cuid())
  transactionId String
  amount        Float
  paymentDate   DateTime // Historical date from book — shown in ledger
  note          String?
  createdAt     DateTime    @default(now()) // System audit only, never shown
  updatedAt     DateTime    @updatedAt
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}
